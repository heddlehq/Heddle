<!DOCTYPE html>
<html
  lang={html_lang(assigns[:locale])}
  data-theme="dark"
  data-user-theme={user_theme(assigns[:current_scope])}
  data-theme-lock={assigns[:theme_lock]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Heddle" suffix=" · Heddle">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // The theme a person chose (data-user-theme, from their preferences) wins over
      // what this browser remembers. "system" follows the device. A public page
      // (data-theme-lock) always follows its visitor's device.
      (() => {
        const root = document.documentElement;
        const dark = window.matchMedia("(prefers-color-scheme: dark)");
        const resolve = (t) => (t === "system" ? (dark.matches ? "dark" : "light") : t);

        const apply = (t) => {
          const theme = resolve(t || "dark");
          root.dataset.themeChoice = t || "dark";
          root.setAttribute("data-theme", theme);
          root.classList.toggle("dark", theme === "dark");
        };

        const locked = root.dataset.themeLock;
        const chosen = root.dataset.userTheme;

        if (locked) {
          apply(locked);
        } else {
          if (chosen) localStorage.setItem("phx:theme", chosen);
          apply(chosen || localStorage.getItem("phx:theme") || "dark");

          window.addEventListener("storage", (e) => {
            if (e.key === "phx:theme") apply(e.newValue);
          });
          window.addEventListener("phx:set-theme", (e) => {
            const t = (e.detail && e.detail.theme) || e.target.dataset?.phxTheme || "dark";
            localStorage.setItem("phx:theme", t);
            apply(t);
          });
        }

        dark.addEventListener("change", () => {
          if (root.dataset.themeChoice === "system") apply("system");
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
