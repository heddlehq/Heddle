<div
  class="w-full h-[100vh] flex flex-col bg-white dark:bg-slate-950 overflow-hidden relative"
  phx-window-keydown="handle_keydown"
>
  <HeddleUI.Components.Flow.FlowHeader.flow_header
    flow={@current_flow}
    renaming_flow={@renaming_flow}
    can_replace={@current_flow.nodes not in [nil, []]}
    can_edit={@can_edit}
    can_run={@can_run}
    status={VersionsManager.status(assigns)}
    published_number={@published_version && @published_version.number}
    versions_open={@versions_open}
  />
  <Layouts.flash_group flash={@flash} />
  <div class="flex-1 flex overflow-hidden">
    <HeddleUI.Components.Flow.NodeSidebar.node_sidebar
      :if={@can_edit}
      nodes_by_category={@nodes_by_category}
      search_query={@node_search_query}
      collapsed_categories={@collapsed_node_categories}
      recent_nodes={@recent_nodes}
    />
    <HeddleUI.Components.Modals.ExecutionNotice.execution_notice notice={@execution_notice} />
    <script>
      window.Translations = {
        "Run": "<%= gettext("Run") %>",
        "Waiting...": "<%= gettext("Waiting...") %>",
        "Remove Node": "<%= gettext("Remove Node") %>",
        "Configure Node": "<%= gettext("Configure Node") %>",
        "View Error": "<%= gettext("View Error") %>",
        "Edit Code": "<%= gettext("Edit Code") %>",
        "Coming Soon": "<%= gettext("Coming Soon") %>",
        "Select Integration": "<%= gettext("Select Integration") %>",
        "Drag to canvas": "<%= gettext("Drag to canvas") %>",
        "Create Node": "<%= gettext("Create Node") %>",
        "Copy": "<%= gettext("Copy") %>",
        "Paste": "<%= gettext("Paste") %>",
        "Delete Selected": "<%= gettext("Delete Selected") %>",
        "Undo": "<%= gettext("Undo") %>",
        "Redo": "<%= gettext("Redo") %>",
        "Delete connection": "<%= gettext("Delete connection") %>",
        "Title": "<%= gettext("Title") %>",
        "Text": "<%= gettext("Text") %>",
        "Note": "<%= gettext("Note") %>",
        "Section": "<%= gettext("Section") %>",
        "Add Title": "<%= gettext("Add Title") %>",
        "Add Text": "<%= gettext("Add Text") %>",
        "Add Note": "<%= gettext("Add Note") %>",
        "Add Section": "<%= gettext("Add Section") %>",
        "Add a title": "<%= gettext("Add a title") %>",
        "Write something": "<%= gettext("Write something") %>",
        "Name this section": "<%= gettext("Name this section") %>",
        "Color": "<%= gettext("Color") %>",
        "Delete": "<%= gettext("Delete") %>",
        "Manual": "<%= gettext("Manual") %>",
        "Run section": "<%= gettext("Run section") %>",
        "Section settings": "<%= gettext("Section settings") %>",
        "Run with the flow": "<%= gettext("Run with the flow") %>",
        "When off, it runs only from the play button.": "<%= gettext("When off, it runs only from the play button.") %>",
        "Put nodes in this section to run it": "<%= gettext("Put nodes in this section to run it") %>",
        "Nothing in this section can start a run": "<%= gettext("Nothing in this section can start a run") %>",
        "Pinned data": "<%= gettext("Pinned data") %>",
        "Inspect this step": "<%= gettext("Inspect this step") %>",
        "Saved": "<%= gettext("Saved") %>",
        "Saving...": "<%= gettext("Saving...") %>",
        "Reconnecting...": "<%= gettext("Reconnecting...") %>"
      };
    </script>

    <div class="flex min-h-0 min-w-0 flex-1 flex-col">
      <div id="flow-canvas-area" class="relative flex min-h-0 flex-1 flex-col">
        <div
          class="relative min-h-0 flex-1 bg-gray-100 dark:bg-slate-900"
          id="flow-canvas-container"
          phx-update="ignore"
        >
          <div
            id="flow-canvas"
            class="absolute inset-0 w-full h-full"
            phx-hook="FlowCanvas"
            data-read-only={to_string(not @can_edit)}
            data-flow-id={@current_flow.id}
            data-socket-token={@flow_socket_token}
          >
          </div>
          <div
            :if={@can_edit}
            id="canvas-tools"
            class="absolute top-4 left-4 z-10 flex items-center gap-1 rounded-lg border border-gray-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-800"
          >
            <.canvas_tool kind="title" icon="hero-h1" label={gettext("Title")} />
            <.canvas_tool kind="text" icon="hero-bars-3-bottom-left" label={gettext("Text")} />
            <.canvas_tool kind="note" icon="hero-document-text" label={gettext("Note")} />
            <.canvas_tool kind="section" icon="hero-rectangle-group" label={gettext("Section")} />
          </div>
        </div>
        <%!-- After the canvas, never before it: a sibling appearing before it would make LiveView move it. --%>
        <HeddleUI.Components.Flow.VersionPreview.version_preview
          preview={@version_preview}
          published_id={@current_flow.published_version_id}
          can_edit={@can_edit}
          history_open={@versions_open}
        />
        <HeddleUI.Components.Flow.VersionHistory.version_history
          open={@versions_open}
          versions={@streams.versions}
          count={@versions_count}
          published_id={@current_flow.published_version_id}
          previewing_id={@version_preview && @version_preview.version.id}
          can_edit={@can_edit}
        />
      </div>
      <HeddleUI.Components.Flow.RunInspector.run_inspector
        inspector={@inspector}
        can_edit={@can_edit}
        can_run={@can_run}
      />
      <HeddleUI.Components.Flow.TerminalPanel.terminal_panel
        :if={@terminal_available}
        open={@terminal_open}
        exited={@terminal_exited}
        token={@terminal_token}
        flow_id={@current_flow.id}
        chat_open={@chat_open}
      />
    </div>
  </div>

  <HeddleUI.Components.Modals.CodeEditorModal.code_editor_modal
    modal_open={@modal_open}
    current_code_tab={@current_code_tab}
    current_code_elixir={@current_code_elixir}
    current_code_python={@current_code_python}
    available_variables={@available_variables}
    conflict={@code_conflict}
    revision={@code_revision}
  />
  <HeddleUI.Components.Modals.NodeConfigModal.node_config_modal
    config_modal_open={@config_modal_open}
    editing_node_data={@editing_node_data}
    credentials={@credentials}
    read_only={not @can_edit}
  />
  <HeddleUI.Components.Modals.FlowSettingsModal.flow_settings_modal
    open={@flow_settings_open}
    form={@flow_settings_form}
    options={@error_flow_options}
  />
  <HeddleUI.Components.Modals.PublishModal.publish_modal
    open={@publish_open}
    form={@publish_form}
    status={VersionsManager.status(assigns)}
  />
  <HeddleUI.Components.Modals.WebhookTestModal.webhook_test_modal
    open={@webhook_test_open}
    form={@webhook_test_form}
    error={@webhook_test_error}
    fields={@webhook_test_fields}
  />
  <HeddleUI.Components.Modals.CreateNodeModal.create_node_modal
    create_node_modal_open={@create_node_modal_open}
    available_nodes={@filtered_nodes}
    selected_position={@selected_position}
    search_query={@node_modal_search_query}
  />
  <.live_component
    :if={@ai_configured}
    module={HeddleUI.Components.ChatComponent}
    id="chat-component"
    open={@chat_open}
    agent={@agent}
    waiting={@pending_agent_message != nil}
    history_open={@agent_history_open}
    history={@agent_history}
    terminal_open={@terminal_available and @terminal_open}
    on_toggle="toggle_chat"
    on_send="send_message"
    node_config_open={@config_modal_open}
  />
</div>
